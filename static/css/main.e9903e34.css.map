.input::-webkit-outer-spin-button,
.input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
.input::placeholder{
    color: #1D67CD70;
    font-size: 0.9rem;
}
.formText{
    font-family: 'Sen', sans-serif;
    color: #1D67CD;
}
.h1{
    font-size: 2rem;
    padding: 2% 0;
}
.button{
    background-color: #1D67CD;
    color: white;
    border-radius: 0%;
    -webkit-box-shadow: 5px 5px 0px 1px rgba(104,154,222,0.35);
    box-shadow: 5px 5px 0px 1px rgba(104,154,222,0.35);
}
.button:hover{
    background-color: #1D67CD90;
    color: white;
    -webkit-box-shadow: 0px 0px 0px 3px rgba(29,103,205,0.35);
    box-shadow: 0px 0px 0px 3px rgba(29,103,205,0.35);
}
.button:disabled{
    background-color: rgba(29, 103, 205, 0.44);
    color: white;
    -webkit-box-shadow: 0px 0px 0px 3px rgba(29,103,205,0.35);
    box-shadow: 0px 0px 0px 3px rgba(29,103,205,0.35);
}
.container {
    display: flex;
    align-items: center;
    padding-top: 10%
}


