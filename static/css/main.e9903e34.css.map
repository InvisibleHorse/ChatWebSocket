.mainChat{
    display: flex;
    align-content: flex-end;
    flex-wrap: wrap;
}
.mainChatElement{
    width:100%;
}
.zeroPadding {
    padding:0;
}
.textAlign {
    text-align: left;
}

.sidebar {
    height: 100%;
    width: 16.66%; 
}

.forSidebar {
    padding: 8px 16px;
}
.minHeight{
    min-height: 31rem;
}
.messageList {
    display: flex;
    flex-direction: column;
    padding: 5% 5%;
    height: 31rem;
    overflow-y: auto;
}
.yourMessage {
    background-color: #1D67CD;
    word-wrap: break-word;
    max-width: 75%;
    align-self: flex-end;
    margin: 0.5rem 0;
    border-radius: 0.35em;
    padding: 0.5rem;
    color: white;
}

.notYourMessage {
    background-color: #1D67CD75;
    word-wrap: break-word;
    max-width: 75%;
    align-self: flex-start;
    margin: 0.5rem 0;
    border-radius: 0.35em;
    padding: 0.5rem;
    color: white;
}
.blockquote {
    padding:0.3rem;
    color:white;
    float: left;
    clear: left;
    text-shadow: 1px 1px rgba(27, 94, 187, 0.31);;
}
.messageInput{
    display:inline-flex;
    width:100%;
    padding: 0 5% 2% 5%;
}
.sendMessageBtn{
    margin-left: 1rem;
    border-radius: .35em;
}
.span {
    color: rgba(255, 255, 255, 0.5);
    padding: 0 0.5rem;
    float: right;
    clear: right;
}
.roomNumber {
    font-weight: bold;
    color: #1D67CD95;
}

@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        top: 0;
        left: -80%;
        width: 70%;
        max-width: 300px;
        height: 100%;
        background-color: #f5f5f5;
        z-index: 1000;
        transition: left 0.3s ease-in-out;
        box-shadow: 2px 0 8px rgba(0,0,0,0.3);
    }

    .sidebarOpen {
        left: 0;
    }

    .toggleBtn {
        display: block;
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 1100;
        background: #1D67CD;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 0.3rem;
    }
}

@media (min-width: 769px) {
    .toggleBtn {
        display: none;
    }
}